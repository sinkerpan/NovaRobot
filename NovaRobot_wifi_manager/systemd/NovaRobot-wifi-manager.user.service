[Unit]
Description=NovaRobot TR One Wi-Fi Manager (user)
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/novarobot/NovaRobot_wifi_manager
Environment=PYTHONPATH=/home/novarobot/NovaRobot_wifi_manager
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m NovaRobot_wifi_manager
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
