#!/bin/sh
set -e

mkdir -p /var/lib/novarobot-wifi-manager

if [ "$1" = configure ]; then
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable novarobot-wifi-manager.service >/dev/null 2>&1 || true
    if systemctl is-system-running >/dev/null 2>&1; then
      systemctl try-restart bluetooth.service >/dev/null 2>&1 || true
      systemctl restart novarobot-wifi-manager.service >/dev/null 2>&1 || true
    fi
  fi
fi

exit 0
