[Unit]
Description=NovaRobot TR One Wi-Fi Manager (AP/STA/BLE/mDNS/UDP)
After=NetworkManager.service bluetooth.service avahi-daemon.service
Wants=NetworkManager.service bluetooth.service avahi-daemon.service

[Service]
Type=simple
WorkingDirectory=/usr/lib/novarobot-wifi-manager
Environment=PYTHONPATH=/usr/lib/novarobot-wifi-manager
Environment=NOVAROBOT_WIFI_CONFIG=/etc/novarobot-wifi-manager/default.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m NovaRobot_wifi_manager
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
